{
    "name": "php-baremetal/touch-gt911",
    "description": "GT911 touch controller driver for ext-i2c (Baremetal\\I2c\\Driver\\Gt911, Baremetal\\Input\\Touch): up to five fingers, events with an id per finger, from the INT line or polled when INT is not wired.",
    "type": "bm-lib",
    "license": "MIT",
    "authors": [{ "name": "Gianfrancesco Aurecchia", "email": "gianfri@php-baremetal.com" }],
    "require": {
        "php": ">=8.3",
        "php-baremetal/ext-i2c": "^1.1.1",
        "php-baremetal/i2c-hal": "^1.3",
        "php-baremetal/ext-input": "^1.1",
        "php-baremetal/ext-gpio": "^1.2",
        "php-baremetal/bm-common": "^1.2"
    },
    "extra": {
        "baremetal": {
            "register": {
                "i2c_drivers": ["gt911_driver_desc"]
            },
            "board-blocks": ["touch:gt911"],
            "ide-stubs": ["ide/touch-gt911.stub"]
        }
    }
}
